# docker compose 會讀取此檔（複製為 .env）。不設定也能用預設值啟動。

# JWT 金鑰（正式環境務必更換為隨機長字串）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Web Push VAPID 金鑰（選配；要啟用出貨組背景推播才需要）
# 產生方式：cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
