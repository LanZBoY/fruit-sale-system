# 後端環境變數範例（複製為 .env 後修改）
PORT=3000
DATABASE_URL=postgres://fruit:fruit@localhost:5432/fruit_sales

# JWT 金鑰（正式環境務必更換）
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS（前端網域；docker 內由 nginx 代理可設 *）
CORS_ORIGIN=*

# 商品圖片儲存目錄
UPLOAD_DIR=/app/uploads
# 圖片對外網址前綴（留空則用相對路徑 /uploads/...）
PUBLIC_BASE_URL=

# Web Push VAPID（選配，留空則停用推播）
# 產生：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
